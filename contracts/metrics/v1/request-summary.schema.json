{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/metrics/v1/request-summary.schema.json",
  "title": "Observed request population summary v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "aggregation_revision", "population_key", "population_status", "run_ids", "metric_id", "completed_count", "valid_count", "failed_count", "cancelled_count", "incomplete_count", "provenance_key", "summary", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "aggregation_revision": {"const": "exact-field-nearest-rank-1"},
    "population_key": {"$ref": "../../collector/v1/common.schema.json#/$defs/populationKey"},
    "population_status": {"enum": ["complete", "partial", "expired"]},
    "run_ids": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}},
    "metric_id": {"enum": ["request.client.first_byte_ms", "request.client.first_content_ms", "request.client.total_ms", "request.runtime.total_duration_ms", "request.runtime.load_duration_ms", "request.runtime.prompt_eval_duration_ms", "request.runtime.eval_duration_ms", "request.runtime.prompt_tokens", "request.runtime.output_tokens"]},
    "completed_count": {"type": "integer", "minimum": 0, "maximum": 250000},
    "valid_count": {"type": "integer", "minimum": 0, "maximum": 250000},
    "failed_count": {"type": "integer", "minimum": 0, "maximum": 250000},
    "cancelled_count": {"type": "integer", "minimum": 0, "maximum": 250000},
    "incomplete_count": {"type": "integer", "minimum": 0, "maximum": 250000},
    "provenance_key": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "verification_state", "metric_source"],
      "properties": {
        "source_kind": {"enum": ["deliberate_probe", "imported_test"]},
        "verification_state": {"enum": ["direct_capture", "operator_imported_unverified"]},
        "metric_source": {"enum": ["client_monotonic", "ollama_terminal", "operator_import"]}
      },
      "allOf": [
        {"if": {"properties": {"source_kind": {"const": "deliberate_probe"}}}, "then": {"properties": {"verification_state": {"const": "direct_capture"}, "metric_source": {"enum": ["client_monotonic", "ollama_terminal"]}}}},
        {"if": {"properties": {"source_kind": {"const": "imported_test"}}}, "then": {"properties": {"verification_state": {"const": "operator_imported_unverified"}, "metric_source": {"const": "operator_import"}}}}
      ]
    },
    "summary": {"anyOf": [{"$ref": "#/$defs/summary"}, {"type": "null"}]},
    "warnings": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "contains": {"const": "explicit_observed_requests_only"}, "items": {"enum": ["explicit_observed_requests_only", "other_ollama_traffic_absent", "population_expired_or_partial", "operator_imported_unverified"]}}
  },
  "allOf": [
    {"if": {"properties": {"valid_count": {"const": 0}}}, "then": {"properties": {"summary": {"const": null}}}},
    {"if": {"properties": {"valid_count": {"minimum": 1, "maximum": 99}}}, "then": {"properties": {"summary": {"allOf": [{"$ref": "#/$defs/summary"}, {"properties": {"p95": {"const": null}}}]}}}},
    {"if": {"properties": {"valid_count": {"minimum": 100}}}, "then": {"properties": {"summary": {"allOf": [{"$ref": "#/$defs/summary"}, {"properties": {"p95": {"type": "number"}}}]}}}},
    {"if": {"properties": {"population_status": {"enum": ["partial", "expired"]}}}, "then": {"properties": {"warnings": {"contains": {"const": "population_expired_or_partial"}}}}},
    {"if": {"properties": {"provenance_key": {"properties": {"source_kind": {"const": "imported_test"}}}}}, "then": {"properties": {"warnings": {"contains": {"const": "operator_imported_unverified"}}}}}
  ],
  "$defs": {
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["valid_n", "minimum", "median", "maximum", "p95", "algorithm"],
      "properties": {
        "valid_n": {"type": "integer", "minimum": 1, "maximum": 250000},
        "minimum": {"type": "number", "minimum": 0},
        "median": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0},
        "p95": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "algorithm": {"const": "exact_median_empirical_nearest_rank_p95"}
      }
    }
  }
}
