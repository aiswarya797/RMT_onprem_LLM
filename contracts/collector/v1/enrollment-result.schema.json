{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/collector/v1/enrollment-result.schema.json",
  "title": "One-time collector enrollment result v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "deployment_id", "host_id", "security_generation", "certificate_pem", "certificate_chain_pem", "expires_ms", "hub_ca_fingerprint_sha256"],
  "properties": {
    "protocol": {"const": "1.0"},
    "deployment_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "host_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "security_generation": {"$ref": "common.schema.json#/$defs/epoch"},
    "certificate_pem": {"type": "string", "minLength": 64, "maxLength": 32768, "pattern": "^-----BEGIN CERTIFICATE-----"},
    "certificate_chain_pem": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 64, "maxLength": 32768, "pattern": "^-----BEGIN CERTIFICATE-----"}},
    "expires_ms": {"$ref": "common.schema.json#/$defs/uint53"},
    "hub_ca_fingerprint_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
