{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/collector/v1/recovery-ack.schema.json",
  "title": "Durable recovery replay acknowledgement v1",
  "type": "object", "additionalProperties": false,
  "required": ["grant_id", "grant_sha256", "replay_request_id", "scope_sha256", "durable", "accepted", "duplicate", "rejected", "receipts", "complete", "hub_time_ms"],
  "properties": {
    "grant_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "grant_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "replay_request_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "scope_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "durable": {"const": true},
    "accepted": {"type": "integer", "minimum": 0, "maximum": 64},
    "duplicate": {"type": "integer", "minimum": 0, "maximum": 64},
    "rejected": {"type": "integer", "minimum": 0, "maximum": 64},
    "receipts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["original_collector_boot_id", "original_source_id", "original_sequence", "original_payload_sha256", "disposition"], "properties": {"original_collector_boot_id": {"$ref": "common.schema.json#/$defs/uuid"}, "original_source_id": {"$ref": "common.schema.json#/$defs/uuid"}, "original_sequence": {"$ref": "common.schema.json#/$defs/uint53"}, "original_payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "disposition": {"enum": ["recovered", "duplicate", "expired", "corrupt", "incompatible", "alignment_unavailable", "missing_unrecoverable"]}}}},
    "complete": {"type": "boolean"},
    "hub_time_ms": {"$ref": "common.schema.json#/$defs/uint53"}
  }
}
