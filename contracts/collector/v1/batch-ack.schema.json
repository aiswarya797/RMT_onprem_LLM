{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/collector/v1/batch-ack.schema.json",
  "title": "Durable batch acknowledgement v1",
  "type": "object", "additionalProperties": false,
  "required": ["batch_id", "durable", "accepted", "duplicate", "hub_time_ms", "next_send_after_ms", "control_requests"],
  "properties": {
    "batch_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "durable": {"const": true},
    "accepted": {"type": "integer", "minimum": 0, "maximum": 64},
    "duplicate": {"type": "integer", "minimum": 0, "maximum": 64},
    "hub_time_ms": {"$ref": "common.schema.json#/$defs/uint53"},
    "next_send_after_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
    "control_requests": {"type": "array", "maxItems": 8, "items": {"$ref": "control-request.schema.json"}}
  }
}
