{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/collector/v1/status-ack.schema.json",
  "title": "Durable source status acknowledgement v1",
  "type": "object", "additionalProperties": false,
  "required": ["collector_boot_id", "sequence", "durable", "duplicate", "hub_time_ms", "control_requests"],
  "properties": {
    "collector_boot_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "sequence": {"$ref": "common.schema.json#/$defs/uint53"},
    "durable": {"const": true},
    "duplicate": {"type": "boolean"},
    "hub_time_ms": {"$ref": "common.schema.json#/$defs/uint53"},
    "control_requests": {"type": "array", "maxItems": 8, "items": {"$ref": "control-request.schema.json"}}
  }
}
