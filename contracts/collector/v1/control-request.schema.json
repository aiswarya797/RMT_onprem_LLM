{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/collector/v1/control-request.schema.json",
  "title": "Finite collector control request v1",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "host_id", "target_id", "operation", "expires_ms"],
  "properties": {
    "request_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "host_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "target_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "operation": {"const": "refresh_existing_target"},
    "expires_ms": {"$ref": "common.schema.json#/$defs/uint53"}
  }
}
