{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/api/v1/response.schema.json",
  "title": "Typed API response values v1",
  "$defs": {
    "annotationList": {
      "$ref": "incident-response.schema.json#/$defs/annotationList"
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bootstrapState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "expires_ms"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "state": {
          "enum": [
            "required",
            "expired",
            "configured"
          ]
        },
        "expires_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "expires_ms",
        "csrf_token"
      ],
      "properties": {
        "user": {
          "$ref": "#/$defs/user"
        },
        "expires_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "csrf_token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        }
      }
    },
    "foundationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_ms",
        "deployment_state",
        "hub_state",
        "collector_state",
        "target_state",
        "host_count",
        "target_count",
        "source_count",
        "collection_started",
        "inference_started",
        "storage_state"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "generated_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "deployment_state": {
          "$ref": "deployment-state.schema.json"
        },
        "hub_state": {
          "const": "configured"
        },
        "collector_state": {
          "enum": [
            "not_registered",
            "registered_not_observed",
            "observing",
            "stale_or_disconnected"
          ]
        },
        "target_state": {
          "enum": [
            "none",
            "reachable",
            "unreachable",
            "partial_or_unknown"
          ]
        },
        "host_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "target_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "source_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "collection_started": {
          "type": "boolean"
        },
        "inference_started": {
          "const": false
        },
        "storage_state": {
          "enum": [
            "normal",
            "warning",
            "optional_jobs_stopped",
            "bulk_ingest_paused",
            "read_only_enospc"
          ]
        },
        "evaluator": {
          "$ref": "#/$defs/evaluatorStatus"
        },
        "experimental_features": {
          "type": "boolean",
          "description": "False unless experimental workflows were explicitly enabled for this process. Omitted by older hubs; clients must default to false."
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "user_id",
        "username",
        "display_name",
        "scope",
        "created_ms",
        "expires_ms",
        "revoked_ms"
      ],
      "properties": {
        "id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/sha256"
        },
        "user_id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "display_name": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/safeString"
        },
        "scope": {
          "enum": [
            "admin",
            "viewer"
          ]
        },
        "created_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "expires_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "revoked_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tokenList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "tokenOnce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "token",
        "record"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "record": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "tokenRevocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revoked_ms"
      ],
      "properties": {
        "id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/sha256"
        },
        "revoked_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        }
      }
    },
    "sourceState": {
      "enum": [
        "not_observed",
        "fresh",
        "stale",
        "disconnected",
        "unavailable",
        "incompatible",
        "partial"
      ]
    },
    "metricReading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "unit",
        "scope_id",
        "source_id",
        "observed_ms",
        "age_ms",
        "value",
        "quality",
        "missing_reason",
        "method_revision",
        "provenance"
      ],
      "properties": {
        "metric": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/metricId"
        },
        "unit": {
          "enum": [
            "ratio",
            "state",
            "bytes",
            "boolean",
            "milliseconds",
            "tokens"
          ]
        },
        "scope_id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
        },
        "source_id": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "age_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/quality"
        },
        "missing_reason": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/missingReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "method_revision": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/safeString"
        },
        "provenance": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/provenance"
        }
      }
    },
    "overviewModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alias",
        "digest",
        "loaded",
        "load_state",
        "reported_size_bytes",
        "reported_size_vram_bytes",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
        },
        "alias": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/safeString"
            },
            {
              "type": "null"
            }
          ]
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "loaded": {
          "type": "boolean"
        },
        "load_state": {
          "enum": [
            "reported_loaded",
            "reported_not_loaded",
            "unavailable"
          ]
        },
        "reported_size_bytes": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint64Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "reported_size_vram_bytes": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint64Decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/provenance"
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_ms",
        "deployment_state",
        "state",
        "host_count",
        "target_count",
        "open_incident_count",
        "observed_request_population",
        "history_available",
        "hosts",
        "targets",
        "capabilities_missing"
      ],
      "properties": {
        "generated_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "deployment_state": {
          "$ref": "deployment-state.schema.json"
        },
        "state": {
          "$ref": "#/$defs/sourceState"
        },
        "host_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "target_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "open_incident_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "observed_request_population": {
          "enum": [
            "present",
            "absent",
            "partial",
            "expired"
          ]
        },
        "history_available": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/host"
          }
        },
        "targets": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "capabilities_missing": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../../collector/v1/common.schema.json#/$defs/missingCapability"
          }
        }
      }
    },
    "historyScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "display_name",
        "retired",
        "host_id",
        "target_id",
        "earliest_retained_ms",
        "latest_retained_ms",
        "metrics"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
            },
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/sha256"
            }
          ]
        },
        "kind": {
          "enum": [
            "host",
            "runtime",
            "model",
            "process"
          ]
        },
        "display_name": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/safeString"
        },
        "retired": {
          "type": "boolean"
        },
        "host_id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
        },
        "target_id": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "earliest_retained_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "latest_retained_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "../../collector/v1/common.schema.json#/$defs/metricId"
          }
        }
      }
    },
    "historyCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_ms",
        "earliest_retained_ms",
        "latest_retained_ms",
        "scopes",
        "truncated"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "generated_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "earliest_retained_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_retained_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/historyScope"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "local",
        "state",
        "source_state",
        "collector_version",
        "current_session_generation",
        "updated_ms",
        "heartbeat_ms",
        "heartbeat_age_ms",
        "metrics",
        "network_observed_ms",
        "network_age_ms",
        "network_observations",
        "process_observed_ms",
        "process_age_ms",
        "process_summary",
        "process_observations",
        "capabilities_missing"
      ],
      "properties": {
        "id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
        },
        "display_name": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/safeString"
        },
        "local": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "active",
            "retired",
            "revoked",
            "not_reporting"
          ]
        },
        "source_state": {
          "$ref": "#/$defs/sourceState"
        },
        "collector_version": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/safeString"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_session_generation": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "updated_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "heartbeat_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "heartbeat_age_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/metricReading"
          }
        },
        "network_observed_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "network_age_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "network_observations": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "../../collector/v1/network-observation.schema.json"
          }
        },
        "process_observed_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_age_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_summary": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/process-summary.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "process_observations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../../collector/v1/process-observation.schema.json"
          }
        },
        "capabilities_missing": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../../collector/v1/common.schema.json#/$defs/missingCapability"
          }
        }
      }
    },
    "hostList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/host"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host_id",
        "host_local",
        "display_name",
        "adapter_id",
        "association_state",
        "retired",
        "source_state",
        "reachable",
        "models_state",
        "models_observed_ms",
        "models_age_ms",
        "models",
        "capabilities_missing"
      ],
      "properties": {
        "id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
        },
        "host_id": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uuid"
        },
        "host_local": {
          "type": "boolean"
        },
        "display_name": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/safeString"
        },
        "adapter_id": {
          "const": "ollama"
        },
        "association_state": {
          "enum": [
            "verified",
            "declared_unverified",
            "ambiguous"
          ]
        },
        "retired": {
          "type": "boolean"
        },
        "source_state": {
          "$ref": "#/$defs/sourceState"
        },
        "reachable": {
          "$ref": "#/$defs/metricReading"
        },
        "models_state": {
          "$ref": "#/$defs/sourceState"
        },
        "models_observed_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "models_age_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/overviewModel"
          }
        },
        "capabilities_missing": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../../collector/v1/common.schema.json#/$defs/missingCapability"
          }
        }
      }
    },
    "targetList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/target"
          }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "ready",
            "not_ready"
          ]
        }
      }
    },
    "evaluatorStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started",
        "last_attempt_ms",
        "last_success_ms",
        "lag_ms",
        "last_pass_failed"
      ],
      "properties": {
        "started": {
          "type": "boolean"
        },
        "last_attempt_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success_ms": {
          "anyOf": [
            {
              "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
            },
            {
              "type": "null"
            }
          ]
        },
        "lag_ms": {
          "$ref": "../../collector/v1/common.schema.json#/$defs/uint53"
        },
        "last_pass_failed": {
          "type": "boolean"
        }
      }
    },
    "monitorHealth": {
      "type": "object",
