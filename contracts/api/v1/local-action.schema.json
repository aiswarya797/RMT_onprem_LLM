{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-monitor.local/contracts/api/v1/local-action.schema.json",
  "title": "Finite local-owner CLI requests v1",
  "$defs": {
    "installCheck": {"type": "object", "additionalProperties": false, "required": ["role"], "properties": {"role": {"const": "local"}}},
    "setupLocal": {"type": "object", "additionalProperties": false, "required": ["start"], "properties": {"start": {"type": "boolean"}}},
    "targetAdd": {"type": "object", "additionalProperties": false, "required": ["manifest_path", "manifest_sha256", "reviewed_manifest", "confirm_deployment_id"], "properties": {"manifest_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "manifest_sha256": {"$ref": "../../collector/v1/common.schema.json#/$defs/sha256"}, "reviewed_manifest": {"$ref": "local-target-manifest.schema.json"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "targetEdit": {"type": "object", "additionalProperties": false, "required": ["target_id", "expected_revision", "manifest_path", "manifest_sha256", "reviewed_manifest", "confirm_deployment_id"], "properties": {"target_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}, "expected_revision": {"type": "integer", "minimum": 1}, "manifest_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "manifest_sha256": {"$ref": "../../collector/v1/common.schema.json#/$defs/sha256"}, "reviewed_manifest": {"$ref": "local-target-manifest.schema.json"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "targetRemove": {"type": "object", "additionalProperties": false, "required": ["target_id", "confirm_deployment_id"], "properties": {"target_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "credentialSet": {"type": "object", "additionalProperties": false, "required": ["credential_kind", "secret_from_stdin", "confirm_deployment_id"], "properties": {"credential_kind": {"enum": ["webhook_hmac", "smtp_password"]}, "secret_from_stdin": {"const": true}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "credentialTest": {"type": "object", "additionalProperties": false, "required": ["destination_id", "confirm_deployment_id"], "properties": {"destination_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "permissionCheck": {"type": "object", "additionalProperties": false, "required": ["check"], "properties": {"check": {"enum": ["darwin_metrics", "local_socket", "data_directory"]}}},
    "probeRun": {"type": "object", "additionalProperties": false, "required": ["target_id", "profile_id", "count", "load_confirmation", "confirm_deployment_id"], "properties": {"target_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}, "profile_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/safeCode"}, "count": {"const": 1}, "load_confirmation": {"type": "object", "additionalProperties": false, "required": ["confirmation", "profile_sha256", "displayed_budget_sha256"], "properties": {"confirmation": {"const": "confirm_load"}, "profile_sha256": {"$ref": "../../collector/v1/common.schema.json#/$defs/sha256"}, "displayed_budget_sha256": {"$ref": "../../collector/v1/common.schema.json#/$defs/sha256"}}}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "bundleInspect": {"type": "object", "additionalProperties": false, "required": ["bundle_path"], "properties": {"bundle_path": {"type": "string", "minLength": 1, "maxLength": 1024}}},
    "backupCreate": {"type": "object", "additionalProperties": false, "required": ["destination_path", "confirm_deployment_id", "deployment_generation"], "properties": {"destination_path": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"}, "key_file_path": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"}, "key_out_path": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}, "deployment_generation": {"$ref": "../../collector/v1/common.schema.json#/$defs/epoch"}}, "oneOf": [{"required": ["key_file_path"], "not": {"required": ["key_out_path"]}}, {"required": ["key_out_path"], "not": {"required": ["key_file_path"]}}]},
    "backupVerify": {"type": "object", "additionalProperties": false, "required": ["backup_path", "key_file_path", "confirm_deployment_id"], "properties": {"backup_path": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"}, "key_file_path": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "restore": {"type": "object", "additionalProperties": false, "required": ["confirm_deployment_id", "deployment_generation", "confirm_recovery_point_ms"], "properties": {"backup_path": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"}, "key_file_path": {"type": "string", "minLength": 2, "maxLength": 1024, "pattern": "^/[^\\u0000-\\u001f\\u007f]*$"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}, "deployment_generation": {"$ref": "../../collector/v1/common.schema.json#/$defs/epoch"}, "confirm_recovery_point_ms": {"$ref": "../../collector/v1/common.schema.json#/$defs/uint53"}, "resume_transaction": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}, "oneOf": [{"required": ["backup_path", "key_file_path"], "not": {"required": ["resume_transaction"]}}, {"required": ["resume_transaction"], "not": {"anyOf": [{"required": ["backup_path"]}, {"required": ["key_file_path"]}]}}]},
    "upgrade": {"type": "object", "additionalProperties": false, "required": ["artifact_path", "artifact_sha256", "confirm_deployment_id"], "properties": {"artifact_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "artifact_sha256": {"$ref": "../../collector/v1/common.schema.json#/$defs/sha256"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "uninstallPreview": {"type": "object", "additionalProperties": false, "required": ["kept_data"], "properties": {"kept_data": {"type": "boolean"}}},
    "uninstallKeep": {"type": "object", "additionalProperties": false, "required": ["deployment_generation"], "properties": {"deployment_generation": {"$ref": "../../collector/v1/common.schema.json#/$defs/epoch"}}},
    "uninstallPurge": {"type": "object", "additionalProperties": false, "required": ["deployment_generation", "confirm_deployment_id", "backup_offer_acknowledged"], "properties": {"deployment_generation": {"$ref": "../../collector/v1/common.schema.json#/$defs/epoch"}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}, "backup_offer_acknowledged": {"const": true}}},
    "recoveryPreview": {"type": "object", "additionalProperties": false, "required": ["spool_directory", "confirm_deployment_id"], "properties": {"spool_directory": {"type": "string", "minLength": 1, "maxLength": 1024}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}},
    "recoveryApply": {"type": "object", "additionalProperties": false, "required": ["manifest_path", "grant_path", "confirm_deployment_id"], "properties": {"manifest_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "grant_path": {"type": "string", "minLength": 1, "maxLength": 1024}, "confirm_deployment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"}}}
  }
}
