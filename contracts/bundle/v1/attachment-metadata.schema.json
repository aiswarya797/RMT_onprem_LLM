{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://llm-monitor.local/contracts/bundle/v1/attachment-metadata.schema.json",
  "title": "Approved opaque bundle attachment metadata v1", "type": "object", "additionalProperties": false,
  "required": ["attachment_id", "filename", "media_type", "size_bytes", "sha256", "verification_state", "approved_by", "approved_ms", "warning"],
  "properties": {
    "attachment_id": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"},
    "filename": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^/\\\\]+$"},
    "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "size_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
    "sha256": {"$ref": "../../collector/v1/common.schema.json#/$defs/sha256"},
    "verification_state": {"const": "operator_approved_unverified"},
    "approved_by": {"$ref": "../../collector/v1/common.schema.json#/$defs/uuid"},
    "approved_ms": {"$ref": "../../collector/v1/common.schema.json#/$defs/uint53"},
    "warning": {"const": "opaque_content_not_covered_by_structured_redaction"}
  }
}
